# Internal Service System — operator env file
# Copy to .env and fill in real values. NEVER commit .env.

# mDNS hostname of the CA host. Becomes `<CA_HOSTNAME>.local` on the LAN.
# Also the avahi host-name. Must match `hostname -s` on the CA host.
CA_HOSTNAME=ca

# The CA's cert subject O (Organization). Appears in every issued cert.
# Plain text only — letters, digits, spaces, commas, periods.
CA_NAME=MyCompanyLLC

# IP of the CA host. Used in cert SANs and Traefik config.
CA_IP=10.0.0.10

# Set true on the CA host itself. Set false on every other host that joins
# the mesh.
JOIN_AS_CA=true

# Operator-configurable install paths. Defaults match this template.
ISS_USER=dev
ISS_HOME=/home/dev
ISS_CONFIG_DIR=/etc/iss
ISS_STATE_DIR=/var/lib/iss

# Operator-friendly brand name shown in the enroll page title and footer.
ISS_NAME=MyCompanyLLC

# Shared password users enter at the enroll page to get a cert.
ENROLL_HOUSEHOLD_PASSWORD=changeme

# .p12 install password. Mac users type this when importing the cert.
ENROLL_P12_PASSWORD=changeme

# Optional. Port the operator's dashboard listens on. Default: 8080.
# DASHBOARD_PORT=8080

# Optional. Port the enroll app listens on. Default: 8081.
# ENROLL_PORT=8081

# Optional. If set, a separate Traefik router is created for the enroll
# app on this hostname (plain HTTP, no mTLS, no TLS). Example: enroll.local.
# ENROLL_HOSTNAME=enroll.local
