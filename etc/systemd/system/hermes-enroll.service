[Unit]
Description=Cert enrollment (Internal Service System)
After=step-ca.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/dev/.hermes/scripts
ExecStart=/usr/bin/node /home/dev/.hermes/scripts/hermes-enroll.js
# ENROLL_HOUSEHOLD_PASSWORD and ENROLL_P12_PASSWORD are set by the
# bootstrap-created drop-in at /etc/systemd/system/<this-unit>.d/env.conf
# so they never appear in the committed unit file.
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
